{
  "name": "Sensible dashboard",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": { "openFiles": ["README.md", "app.py"] },
    "vscode": { "extensions": ["ms-python.python"] }
  },
  "updateContentCommand": "pip install --user -r requirements-dev.txt",
  "postAttachCommand": "streamlit run app.py --server.enableCORS false --server.enableXsrfProtection false",
  "portsAttributes": { "8501": { "label": "Dashboard", "onAutoForward": "openPreview" } },
  "forwardPorts": [8501]
}
