{
  "name": "Sensible",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  },
  "updateContentCommand": "pip install --user -r requirements-dev.txt && cd web && npm ci && npm run build",
  "postAttachCommand": "python -m uvicorn api.main:app --host 0.0.0.0 --port 8000",
  "portsAttributes": { "8000": { "label": "Sensible", "onAutoForward": "openPreview" } },
  "forwardPorts": [8000]
}
