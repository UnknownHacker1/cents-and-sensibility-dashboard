# Copy this file to .env and fill in what you have. .env is gitignored.
# Never commit real keys, never paste them into code or chat tools.
# Every line is optional: with nothing set, the app runs on the built-in fake bank and the rules engine.

# Event 2: Plaid SANDBOX keys (dashboard.plaid.com > Developers > Keys)
PLAID_CLIENT_ID=
PLAID_SECRET=

# Event 3: Claude for Money Brain (console.anthropic.com). Without it, the rules engine answers.
ANTHROPIC_API_KEY=
# Set to "rules" to force the rules engine even when a key is present.
AI_ENGINE=auto

# Event 4: lock it down
# Long random string that signs session cookies, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Owner password (12+ characters). When set, only the owner can connect a Plaid bank.
APP_PASSWORD=
# Set to 1 when the app is served over HTTPS so cookies are HTTPS-only.
COOKIE_SECURE=0
